{
    "//1": "Category 1: routed through a local v2ray (v2rayN/Xray etc.) SOCKS proxy.",
    "//2": "Requires v2ray already running locally with a SOCKS inbound on the port below.",
    "//3": "Use with: ./target/release/psiphon -config configs/v2ray.psiphon.config -serverList server-list-standard.txt -dataRootDirectory data",

    "PropagationChannelId": "07D1ACD69B3AC7A2",
    "SponsorId": "EE0B7486ACAE75AA",

    "//4": "Adjust to match whatever local port v2ray's SOCKS inbound listens on.",
    "UpstreamProxyURL": "socks5://127.0.0.1:10808",

    "LocalHttpProxyPort": 8082,
    "LocalSocksProxyPort": 11080,

    "//5": "Prefer the least fingerprintable protocols this server list actually has",
    "//6": "(checked directly against server-list-standard.txt - see README's DPI section)",
    "//7": "before falling back to anything else (LimitTunnelProtocols stays unset/unrestricted).",
    "InitialLimitTunnelProtocols": [
        "INPROXY-WEBRTC-OSSH",
        "UNFRONTED-MEEK-SESSION-TICKET-OSSH",
        "UNFRONTED-MEEK-HTTPS-OSSH",
        "TLS-OSSH"
    ],
    "InitialLimitTunnelProtocolsCandidateCount": 50,

    "//8": "Split the first bytes of the handshake (where SNI/identifiers live) across",
    "//9": "several small TCP writes with jitter, instead of one single write.",
    "FragmentorProbability": 1.0,
    "FragmentorMinTotalBytes": 1,
    "FragmentorMaxTotalBytes": 500,
    "FragmentorMinWriteBytes": 1,
    "FragmentorMaxWriteBytes": 100,
    "FragmentorMinDelayMicroseconds": 0,
    "FragmentorMaxDelayMicroseconds": 10000,

    "EmitDiagnosticNotices": true
}
