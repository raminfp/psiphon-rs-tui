{
    "//1": "Category 2: no v2ray / no upstream proxy - Psiphon dials out directly.",
    "//2": "Same protocol hardening as configs/v2ray.psiphon.config, just without the",
    "//3": "UpstreamProxyURL hop through a local SOCKS proxy.",
    "//4": "Use with: ./target/release/psiphon -config configs/direct.psiphon.config -serverList server-list-standard.txt -dataRootDirectory data",

    "PropagationChannelId": "07D1ACD69B3AC7A2",
    "SponsorId": "EE0B7486ACAE75AA",

    "LocalHttpProxyPort": 8082,
    "LocalSocksProxyPort": 11080,

    "InitialLimitTunnelProtocols": [
        "INPROXY-WEBRTC-OSSH",
        "UNFRONTED-MEEK-SESSION-TICKET-OSSH",
        "UNFRONTED-MEEK-HTTPS-OSSH",
        "TLS-OSSH"
    ],
    "InitialLimitTunnelProtocolsCandidateCount": 50,

    "FragmentorProbability": 1.0,
    "FragmentorMinTotalBytes": 1,
    "FragmentorMaxTotalBytes": 500,
    "FragmentorMinWriteBytes": 1,
    "FragmentorMaxWriteBytes": 100,
    "FragmentorMinDelayMicroseconds": 0,
    "FragmentorMaxDelayMicroseconds": 10000,

    "EmitDiagnosticNotices": true
}
